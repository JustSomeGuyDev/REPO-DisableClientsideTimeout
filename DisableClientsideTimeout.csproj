<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework> <!-- Or netstandard2.1 depending on the game -->
    <AssemblyName>DisableClientsideTimeout</AssemblyName>
    <Description>Disables Photon Timeout Disconnect checks</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>DisableClientsideTimeout</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx/Harmony Dependencies -->
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" /> <!-- Adjust Unity version if needed -->

    <!-- Game-Specific Dependencies -->
    <!-- You MUST provide the path to the game's Photon DLLs -->
    <!-- Find these in the game's Managed folder (e.g., GameName_Data/Managed/) -->
    <!-- Example: -->
    <Reference Include="PhotonRealtime">
       <HintPath>C:\Steam\steamapps\common\REPO\REPO_Data\Managed\PhotonRealtime.dll</HintPath>
       <Private>false</Private>
    </Reference>
     <Reference Include="PhotonUnityNetworking">
       <HintPath>C:\Steam\steamapps\common\REPO\REPO_Data\Managed\PhotonUnityNetworking.dll</HintPath>
       <Private>false</Private>
    </Reference>
    <!-- Add other Photon or game-specific DLLs if needed -->
    <Reference Include="Photon3Unity3D">
       <HintPath>C:\Steam\steamapps\common\REPO\REPO_Data\Managed\Photon3Unity3D.dll</HintPath>
       <Private>false</Private>
    </Reference>

  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.TrimEnd(`0123456789`)) == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
